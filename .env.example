# Adresse publique du shop, telle que la Switch la verra (sans / final).
# Exemple : https://shop.mondomaine.fr  ou  http://192.168.1.20:8080 (réseau local)
TICOSHOP_PUBLIC_URL=

# Port exposé sur l'hôte
TICOSHOP_PORT=8080

# Mot de passe de l'interface /admin
TICOSHOP_ADMIN_PASSWORD=change-moi

# Jeton pour l'API et le CLI scripts/ticoshop (en-tête Authorization: Bearer ...)
TICOSHOP_API_TOKEN=

# Clé de signature des sessions (générée par scripts/install.sh)
TICOSHOP_SECRET_KEY=

# Taille max d'un fichier envoyé, en Mo
TICOSHOP_MAX_UPLOAD_MB=4096
