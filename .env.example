# Adresse publique du shop, telle que la Switch la verra (sans / final).
# Exemple : https://shop.mondomaine.fr  ou  http://192.168.1.20:8080 (réseau local)
TICOSHOP_PUBLIC_URL=

# Port exposé sur l'hôte, et interface (127.0.0.1 si Caddy fait le HTTPS)
TICOSHOP_PORT=8080
TICOSHOP_BIND=0.0.0.0

# HTTPS automatique avec Caddy : décommentez les deux lignes
# (ou utilisez ./scripts/install.sh --domain shop.mondomaine.fr)
#COMPOSE_PROFILES=https
#TICOSHOP_DOMAIN=shop.mondomaine.fr

# Derrière un reverse proxy : adresses dont les en-têtes X-Forwarded-For sont crus
# (« * » avec Caddy, car le port de ticoshop n'est alors joignable que par lui).
FORWARDED_ALLOW_IPS=127.0.0.1

# Image Docker utilisée (publiée par la CI GitHub)
TICOSHOP_IMAGE=ghcr.io/leo3438/ticoshop:latest

# Mot de passe du compte « admin » de /admin (d'autres comptes se créent dans l'admin)
TICOSHOP_ADMIN_PASSWORD=change-moi

# Jeton pour l'API et le CLI scripts/ticoshop (en-tête Authorization: Bearer ...)
TICOSHOP_API_TOKEN=

# Clé de signature des sessions (générée par scripts/install.sh)
TICOSHOP_SECRET_KEY=

# Taille max d'un fichier envoyé, en Mo
TICOSHOP_MAX_UPLOAD_MB=4096

# Anciennes versions conservées par paquet
TICOSHOP_KEEP_VERSIONS=10

# Suivi des releases GitHub : intervalle en heures (0 = désactivé).
# Un jeton (sans aucun droit) relève la limite de l'API de 60 à 5000 requêtes/heure.
TICOSHOP_GITHUB_SYNC_HOURS=6
TICOSHOP_GITHUB_TOKEN=

# Notification à chaque nouveau paquet / mise à jour : webhook Discord
# (https://discord.com/api/webhooks/...) ou toute URL acceptant du JSON en POST
TICOSHOP_WEBHOOK_URL=

# Sauvegardes automatiques dans ./backups : intervalle en heures (0 = désactivé) et nombre gardé
TICOSHOP_BACKUP_HOURS=24
TICOSHOP_BACKUP_KEEP=7

# Anti brute-force : N échecs de connexion par IP bloquent pendant M minutes
TICOSHOP_LOGIN_MAX_ATTEMPTS=5
TICOSHOP_LOGIN_WINDOW_MINUTES=15
